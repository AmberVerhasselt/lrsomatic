+    tuple val(meta2), path(fasta)
+    tuple val(meta3), path(fai)
+    tuple val(meta4), path(bed)
 
     output:
     tuple val(meta), path("*.bed.gz")  , emit: bedgz   , optional: true
@@ -21,6 +24,10 @@
     task.ext.when == null || task.ext.when
 
     script:
